# ===== Supabase =====
# Project URL (cloud: https://app.supabase.com → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Anon key (aman untuk client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role key (RAHASIA — hanya di server, jangan pernah di client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ===== NextAuth =====
# Secret acak: jalankan `openssl rand -base64 32`
NEXTAUTH_SECRET=ubah-dengan-secret-acak
NEXTAUTH_URL=http://localhost:3000

# ===== Opsional: database langsung (untuk backup/seed via psql/pg_dump) =====
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ===== Opsional: Google Calendar embed (isi ID kalender publik) =====
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=
